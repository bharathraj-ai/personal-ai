# AI Gateway
PORT=3001

# Minimal local-dev auth (Phase P0)
# Authorization: Bearer <token>
# AUTHENTICATED USER ID ≠ CLIENT-SUPPLIED userId
AUTH_DEV_TOKEN=dev-token
AUTH_DEV_USER_ID=default-user
# Optional second user for isolation tests:
# AUTH_DEV_TOKEN_B=dev-token-b
# AUTH_DEV_USER_ID_B=user-b
# AUTH_DEV_TOKENS={"dev-token":"default-user","dev-token-b":"user-b"}
# AUTH_REJECT_USERID_MISMATCH=true
# Host Downloads/Desktop/Documents create/delete — DISABLED by default (P0)
# ENABLE_HOST_FS_ACTIONS=true

# Own model adapter: bharath (default) | openai-compatible
OWN_MODEL_ADAPTER=bharath

# Bharath AI — your custom model (FastAPI on :8000)
BHARATH_AI_URL=http://localhost:8000
BHARATH_USE_RAG=true
BHARATH_USE_MEMORY=true

# Only if OWN_MODEL_ADAPTER=openai-compatible (vLLM, LiteLLM, etc.)
# OWN_MODEL_URL=http://localhost:8000/v1
# OWN_MODEL_NAME=default
# OWN_MODEL_API_KEY=

# Neon PostgreSQL + pgvector (Phase 6). Without this, in-memory memory/RAG is used.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Embeddings — default is offline local-hash (384-d). For HTTP providers set EMBEDDING_API_URL.
EMBEDDING_PROVIDER=local-hash
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
# EMBEDDING_API_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# RAG tuning
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MAX_CONTEXT_CHARS=6000

# Optional search provider (Phase 7)
# Default DuckDuckGo needs no key. Set Brave/Tavily for higher quality.
SEARCH_PROVIDER=duckduckgo
ENABLE_CHAT_WEB_SEARCH=true
# SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
# SEARCH_API_KEY=

# Phase P2 — Evidence-grounded orchestration + VerificationEngine
ENABLE_EVIDENCE_VERIFICATION=true
EVIDENCE_SEARCH_LIMIT=5
EVIDENCE_FETCH_PAGES=3

# Local sandbox workspaces (Phase 5)
# SANDBOX_ROOT=/absolute/path/to/sandbox/workspaces
# WORKSPACE_LIFETIME_DAYS=30

# S3 persistent storage (optional — uses local-file storage when unset)
# S3_BUCKET=your-bucket
# LOCAL_STORAGE_ROOT=/path/to/data/storage
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=          # optional — MinIO / R2 / other S3-compatible
# S3_FORCE_PATH_STYLE=true
# S3_PRESIGN_SECONDS=900

# Specialist providers (optional workers — Bharath AI remains the default brain)
# Paste API keys to enable. Empty key = provider not registered.

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_ENABLED=true
# GROQ_PRIORITY=10

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_ENABLED=true
# GEMINI_PRIORITY=20

# Cerebras — https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_ENABLED=true
# CEREBRAS_PRIORITY=30

# Optional generic fallback specialist (external APIs only)
# FALLBACK_PROVIDER_URL=https://api.openai.com/v1
# FALLBACK_PROVIDER_MODEL=gpt-4o-mini
# FALLBACK_PROVIDER_API_KEY=sk-...
