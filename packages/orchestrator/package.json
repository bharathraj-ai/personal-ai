    "@personal-ai/shared": "workspace:*",
    "@personal-ai/tools": "workspace:*",
    "@personal-ai/connectors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
